/* Root Container */
.draft-root {
    width: 100%;
    height: 100%;
    background-color: rgba(5, 8, 16, 0.95);
    align-items: center;
    justify-content: center;
    padding: 40px;
}

/* Title */
.draft-title {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(74, 158, 255);
    margin-bottom: 10px;
    text-shadow: 0 0 20px rgba(74, 158, 255, 0.6);
}

.draft-subtitle {
    font-size: 24px;
    color: rgb(176, 184, 200);
    margin-bottom: 40px;
    -unity-font-style: italic;
}

/* Cards Container */
.cards-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 500px;
    margin-bottom: 40px;
}

/* Individual Card */
.equipment-card {
    width: 300px;
    height: 450px;
    margin: 0 20px;
    background-color: rgb(26, 31, 58);
    border-width: 2px;
    border-color: rgb(74, 158, 255);
    border-radius: 12px;
    padding: 20px;
    align-items: center;
    transition: all 0.2s ease;
}

.equipment-card:hover {
    scale: 1.05;
    border-color: rgb(255, 255, 255);
    box-shadow: 0 0 30px rgba(74, 158, 255, 0.4);
}

/* Card Content */
.card-icon {
    width: 128px;
    height: 128px;
    margin-bottom: 20px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
}

.card-name {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 10px;
    white-space: normal;
    text-align: center;
}

.card-type {
    font-size: 16px;
    color: rgb(74, 158, 255);
    margin-bottom: 20px;
}

.card-stats {
    font-size: 16px;
    color: rgb(176, 184, 200);
    white-space: normal;
    text-align: center;
    margin-bottom: auto; /* Pushes button to bottom */
}

/* Select Button (Inside Card) */
.select-button {
    width: 100%;
    height: 50px;
    background-color: rgb(46, 204, 113);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    border-width: 0;
    transition: all 0.2s ease;
}

.select-button:hover {
    background-color: rgb(39, 174, 96);
    scale: 1.05;
}

.select-button-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
}

/* Action Buttons (Bottom Bar) */
.actions-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
}

.action-button {
    width: 200px;
    height: 60px;
    margin: 0 20px;
    border-radius: 8px;
    justify-content: center;
    align-items: center;
    border-width: 2px;
    transition: all 0.2s ease;
}

.reroll-button {
    background-color: rgba(74, 158, 255, 0.2);
    border-color: rgb(74, 158, 255);
}

.reroll-button:hover {
    background-color: rgba(74, 158, 255, 0.4);
    scale: 1.05;
}

.skip-button {
    background-color: rgba(231, 76, 60, 0.2);
    border-color: rgb(231, 76, 60);
}

.skip-button:hover {
    background-color: rgba(231, 76, 60, 0.4);
    scale: 1.05;
}

.button-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: white;
}

.gold-cost {
    font-size: 14px;
    color: rgb(255, 215, 0); /* Gold color */
    margin-top: 4px;
}
