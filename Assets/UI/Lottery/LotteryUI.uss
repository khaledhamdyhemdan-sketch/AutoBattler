/* Root Container */
.lottery-root {
    width: 100%;
    height: 100%;
    background-color: rgba(5, 8, 16, 0.95);
    align-items: center;
    justify-content: center;
    padding: 40px;
}

/* Title */
.lottery-title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(241, 196, 15); /* Gold */
    margin-bottom: 20px;
    text-shadow: 0 0 30px rgba(241, 196, 15, 0.6);
}

.lottery-subtitle {
    font-size: 28px;
    color: rgb(155, 89, 182); /* Purple */
    margin-bottom: 50px;
    -unity-font-style: italic;
}

/* Slot Machine Window */
.slot-machine-container {
    width: 400px;
    height: 500px;
    background-color: rgb(20, 20, 30);
    border-width: 4px;
    border-color: rgb(241, 196, 15);
    border-radius: 20px;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
    overflow: hidden;
}

/* Slot Content (The spinning part) */
.slot-content {
    align-items: center;
    justify-content: center;
}

.slot-icon {
    width: 200px;
    height: 200px;
    margin-bottom: 20px;
    background-color: rgba(0,0,0,0.5);
    border-radius: 10px;
}

.slot-item-name {
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 10px;
    text-align: center;
    white-space: normal;
}

.slot-item-rarity {
    font-size: 24px;
    color: rgb(155, 89, 182);
    margin-bottom: 20px;
}

/* Claim Button */
.claim-button {
    width: 300px;
    height: 80px;
    background-color: rgb(46, 204, 113);
    border-radius: 12px;
    justify-content: center;
    align-items: center;
    border-width: 0;
    transition: all 0.2s ease;
}

.claim-button:hover {
    scale: 1.05;
    background-color: rgb(39, 174, 96);
    box-shadow: 0 0 30px rgba(46, 204, 113, 0.5);
}

.claim-label {
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
}

/* Animation Classes */
.spinning {
    /* CSS animation support in UI Toolkit is limited in Unity 6 without custom manipulators,
       but we can simulate blur or rapid changes via script */
    opacity: 0.8;
}
