:root {
    /* Modern Dark Fantasy Palette */
    --color-background: #05070a;
    --color-surface: #0d1117;
    --color-surface-raised: #161b22;
    --color-surface-highlight: #21262d;
    
    --color-primary: #d7b75a;
    --color-primary-glow: rgba(215, 183, 90, 0.3);
    
    --color-accent: #5ab0ff;
    --color-accent-glow: rgba(90, 176, 255, 0.3);
    
    --color-danger: #ff6b6b;
    --color-success: #35d38a;
    
    --color-text-bright: #f0f6fc;
    --color-text-default: #c9d1d9;
    --color-text-muted: #8b949e;
    --color-text-dark: #484f58;
    
    /* Spacing & Layout */
    --spacing-xs: 4px;
    --spacing-sm: 8px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 32px;

    /* Borders & Radii */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-xl: 20px;
    
    --border-thin: 1px;
    --border-thick: 2px;
}
