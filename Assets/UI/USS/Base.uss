/* Base Styles */
.text-header {
    color: var(--color-primary-gold);
    font-size: 24px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.5);
}

.text-body {
    color: var(--color-text-parchment);
    font-size: 16px;
}

.panel {
    background-color: var(--color-surface);
    border-color: var(--color-primary-gold-dim);
    border-width: var(--border-width-thin);
    border-radius: var(--border-radius-md);
}

.button-medieval {
    background-color: var(--color-surface-highlight);
    border-color: var(--color-primary-gold);
    border-width: var(--border-width-thick);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-parchment);
    padding: var(--spacing-sm) var(--spacing-md);
    transition: scale 0.1s ease-out, background-color 0.1s;
}

.button-medieval:hover {
    background-color: var(--color-primary-gold-dim);
    scale: 1.05;
}

.button-medieval:active {
    background-color: var(--color-primary-gold);
    color: var(--color-background);
    scale: 0.95;
}
