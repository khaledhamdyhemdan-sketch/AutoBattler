.hud-container {
    flex-grow: 1;
    justify-content: space-between;
    padding: var(--spacing-md);
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 60px;
    padding-left: var(--spacing-lg);
    padding-right: var(--spacing-lg);
    background-color: rgba(30, 30, 36, 0.95); /* Slightly transparent surface */
}

.top-bar__section {
    flex-direction: row;
    align-items: center;
    min-width: 200px;
}

.top-bar__center {
    position: absolute;
    left: 50%;
    translate: -50% 0;
}

.right-align {
    justify-content: flex-end;
}

.divider-vertical {
    width: 2px;
    height: 24px;
    background-color: var(--color-primary-gold-dim);
    margin-left: var(--spacing-md);
    margin-right: var(--spacing-md);
}

.phase-label {
    font-size: 18px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin-right: 10px;
}

.preparation-phase {
    color: #c5a059; /* Medieval Gold */
}

.combat-phase {
    color: #e74c3c; /* Crimson */
}

.timer-container {
    width: 50px;
    height: 50px;
    background-color: var(--color-background);
    border-color: var(--color-primary-gold);
    border-width: 2px;
    border-radius: 25px; /* Circle */
    justify-content: center;
    align-items: center;
}

.timer-text {
    color: var(--color-text-parchment);
    font-size: 20px;
    -unity-font-style: bold;
}

.resource-item {
    flex-direction: row;
    align-items: center;
    margin-left: var(--spacing-lg);
    padding: var(--spacing-xs) var(--spacing-md);
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--border-radius-sm);
}

.gold-item {
    border-color: var(--color-primary-gold);
    border-width: 1px;
}

.gold-text {
    color: var(--color-primary-gold);
}

.action-area {
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-end;
    padding-bottom: var(--spacing-lg);
}

.fight-button {
    height: 60px;
    width: 150px;
    font-size: 24px;
    background-color: var(--color-accent-crimson);
    border-color: var(--color-text-parchment);
}

.fight-button:hover {
    background-color: #A03535;
}

.settings-button {
    width: 50px;
    height: 50px;
    margin-left: var(--spacing-md);
    font-size: 24px;
    border-radius: 25px;
}
